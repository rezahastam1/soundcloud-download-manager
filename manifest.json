{
  "manifest_version": 3,
  "name": "SoundCloud Pro Download Manager",
  "version": "3.0.1",
  "description": "Reliable SoundCloud download manager with real progress, Artist - Title naming, Persian-to-Finglish filenames, organized folders, bulk queues and optional FDM hand-off.",
  "permissions": [
    "downloads",
    "declarativeNetRequest",
    "activeTab",
    "tabs",
    "storage",
    "offscreen",
    "cookies"
  ],
  "host_permissions": [
    "https://soundcloud.com/*",
    "https://*.soundcloud.com/*",
    "https://api-v2.soundcloud.com/*",
    "https://*.sndcdn.com/*"
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SoundCloud Pro Download Manager",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://soundcloud.com/*"
      ],
      "js": [
        "ad-engine-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://soundcloud.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "inject.css"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
